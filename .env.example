# Calendrier Tempo EDF : variables d'environnement
# Sur Replit : onglet Secrets. Sur Cloudflare : secrets du Worker (cloudflare/push_secrets.py).
# Toutes les variables lues par l'app sont listées ici (valeur par défaut entre parenthèses).

# === Base de données ===
# PostgreSQL (prod). Si vide : SQLite local (DATABASE_PATH).
DATABASE_URL=
DATABASE_PATH=tempo.db

# === Admin ===
# Mot de passe du tableau de bord /admin. Repli : SESSION_SECRET, sinon généré au démarrage.
ADMIN_PASSWORD=change_me_in_production
SESSION_SECRET=

# === Chiffrement numéros de téléphone (RGPD) ===
# Doit rester IDENTIQUE d'un hébergement à l'autre, sinon les numéros des abonnés sont illisibles.
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PHONE_ENCRYPTION_KEY=

# === Site ===
BASE_URL=https://www.calendrier-tempo.fr
LOG_LEVEL=INFO
# Port HTTP (5000)
PORT=5000

# === API Météo France ===
# Compte sur https://portail-api.meteofrance.fr/ ; abonnements AROME, ARPEGE, Vigilance (gratuits).
# METEOFRANCE_API_KEY sert de repli si une clé spécifique est absente.
METEOFRANCE_API_KEY=
METEOFRANCE_APPLICATION_ID=
METEOFRANCE_AROME_KEY=
METEOFRANCE_ARPEGE_KEY=
METEOFRANCE_VIGILANCE_KEY=

# === RTE (https://data.rte-france.com/) ===
# RTE_CLIENT_ID / _SECRET servent de repli si les clés spécifiques sont absentes.
RTE_CLIENT_ID=
RTE_CLIENT_SECRET=
RTE_CONSO_CLIENT_ID=
RTE_CONSO_CLIENT_SECRET=
RTE_GENERATION_CLIENT_ID=
RTE_GENERATION_CLIENT_SECRET=
# Capacité nucléaire installée en MW (61370)
RTE_NUCLEAR_CAPACITY_MW=61370

# === WhatsApp (Meta Cloud API) ===
# App sur https://developers.facebook.com/ → produit WhatsApp → API Setup.
# Sans WHATSAPP_TOKEN, l'app passe en mode simulation (aucun message envoyé).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Signature des webhooks Meta : OBLIGATOIRE en production (sinon webhook non authentifié).
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=fr
WHATSAPP_TEMPLATE_WELCOME=tempo_bienvenue
WHATSAPP_TEMPLATE_ALERT_ROUGE=tempo_alerte_rouge
WHATSAPP_TEMPLATE_ALERT_BLANC=tempo_alerte_blanc
WHATSAPP_TEMPLATE_CONFIRMATION=tempo_confirmation
WHATSAPP_TEMPLATE_CHANGE=tempo_changement
WHATSAPP_TEMPLATE_RECAP=tempo_recap_hebdo
WHATSAPP_TEMPLATE_MANAGE_LINK=tempo_lien_gestion
# Mode test : si renseigné (ex. +33612345678,+33698765432), les diffusions (alertes,
# changements, confirmations, récap hebdo) ne partent qu'à ces numéros, les autres sont
# journalisées "held" dans sms_logs. Bienvenue, lien de gestion et réponses du bot
# partent à tous. Vide = mode normal.
WHATSAPP_TEST_NUMBERS=

# === Agents IA (SEO + backlinks) ===
# Sans ANTHROPIC_API_KEY, les agents sont ignorés.
ANTHROPIC_API_KEY=
SEO_AGENT_MODEL=claude-sonnet-5-5
SEO_AGENT_MAX_TURNS=40
BACKLINKS_AGENT_MAX_TURNS=35

# === SEO : vérification moteurs + IndexNow ===
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Clé IndexNow (défaut : calendrier-tempo-indexnow-key). Ne pas laisser vide si décommentée.
# INDEXNOW_KEY=

# === Initialisation des compteurs (secours) ===
# Utilisés uniquement si l'API couleur est injoignable au démarrage.
# Début de saison (1er septembre) : 22 rouges, 43 blancs.
TEMPO_REMAINING_ROUGE=22
TEMPO_REMAINING_BLANC=43
