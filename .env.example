# === API Météo France ===
# Créer un compte sur https://portail-api.meteofrance.fr/
# S'abonner aux API : AROME, ARPEGE, Vigilance (gratuit)
# Générer un token via "Mes APIs" → "Générer token"
METEOFRANCE_API_KEY=your_meteofrance_api_key

# === Twilio SMS ===
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+33xxxxxxxxx

# === Admin ===
ADMIN_PASSWORD=change_me_in_production

# === Chiffrement numéros de téléphone (RGPD) ===
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PHONE_ENCRYPTION_KEY=

# === RTE eco2mix (optionnel — enrichit les prévisions) ===
# Créer une app sur https://data.rte-france.com/
RTE_CLIENT_ID=
RTE_CLIENT_SECRET=

# === Initialisation saison (optionnel) ===
# Si l'API EDF n'est pas accessible au démarrage, ces valeurs servent
# à initialiser les compteurs de jours restants pour la saison en cours.
# Consultez https://www.api-couleur-tempo.fr pour les valeurs actuelles.
TEMPO_REMAINING_ROUGE=14
TEMPO_REMAINING_BLANC=14

# === App ===
DATABASE_PATH=tempo.db
LOG_LEVEL=INFO
