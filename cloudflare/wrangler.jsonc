{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calendrier-tempo",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  "containers": [
    {
      "class_name": "TempoApp",
      "image": "../Dockerfile",
      "image_build_context": "..",
      // 1 seule instance : APScheduler tourne dans le conteneur (pas de doublon d'alertes).
      "max_instances": 1,
      // 1/4 vCPU, 1 Gio : suffisant pour FastAPI + scikit-learn.
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "TEMPO_APP", "class_name": "TempoApp" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TempoApp"] }],

  // Keep-alive du conteneur (le scheduler Python gère les vraies tâches).
  "triggers": { "crons": ["*/5 * * * *"] },

  // Domaines (bascule du 2026-10-01) : custom domains attachés par l'API (cloudflare/README.md,
  // phase 2). workers_dev explicite : sans lui, wrangler désactive l'URL de test dès qu'une route existe.
  "workers_dev": true
}
